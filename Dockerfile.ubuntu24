FROM jlesage/baseimage-gui:ubuntu-24.04-v4.12.2

LABEL org.opencontainers.image.title="MediathekView Docker"
LABEL org.opencontainers.image.description="Run MediathekView inside Docker with GUI support via VNC and web browser"
LABEL org.opencontainers.image.vendor="traktuner"
LABEL org.opencontainers.image.source="https://github.com/traktuner/mediathekview-docker"
LABEL org.opencontainers.image.licenses="GPL-3.0"

ENV APP_NAME="MediathekView"
ENV DISPLAY=:0

# Generate and install favicons
# install_app_icon.sh apt-installs imagemagick, which pulls systemd transitively;
# create the /var/log -> /config/log target first so its postinst doesn't fail.
RUN \
    mkdir -p /config/log && \
    APP_ICON_URL=https://avatars.githubusercontent.com/u/23032665 && \
    install_app_icon.sh "$APP_ICON_URL"

# Install all dependencies in a single layer to reduce image size
# The base image symlinks /var/log -> /config/log, which is a dangling link at
# build time. Create the target so systemd's postinst (pulled in via dbus) can
# configure without failing on `mkdir /var/log`.
RUN mkdir -p /config/log && \
    apt-get update && \
    apt-get full-upgrade -y && \
    apt-get install -y --no-install-recommends \
        ffmpeg \
        wget \
        mediathekview \
        openjdk-21-jre && \
    # Cleanup to reduce image size
    apt-get -y autoclean && \
    apt-get -y autoremove && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy startapp.sh and make it executable
COPY rootfs/ /
RUN chmod +x /startapp.sh

# Set working directory
WORKDIR /config

# Add healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD pgrep java || exit 1
